#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        mmv {
            time-to-max-speed-ms = <180>;
            acceleration-exponent = <1>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <170>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_bspc {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp BSPC>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp ESC>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  |  P  |
// | A/⌘ | S/⌥ | D/⌃ | F/⇧ |  G  |   |  H  | J/⇧ | K/⌃ | L/⌥ | ;/⌘ |
// |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  |
//             | GUI |T/LWR| SPC |   | ENT | RSE | MSE |
            bindings = <
   &kp Q        &kp W        &kp E         &kp R         &kp T   &kp Y &kp U         &kp I         &kp O        &kp P
   &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G   &kp H &hmr RSHFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI
   &kp Z        &kp X        &kp C         &kp V         &kp B   &kp N &kp M         &kp COMMA     &kp DOT      &kp FSLH
                               &kp LGUI      &lt 1 TAB     &kp SPACE   &kp RET &mo 2   &mo 3
            >;
        };

        lower_layer {
// -----------------------------------------------------------------------------------------
// |  `  |  "  |  (  |  )  |     |   |  \  |  7  |  8  |  9  |  -  |
// | BT1 | BT2 | BT3 | SFT |BTCLR|   | CAP |  4  |  5  |  6  |  +  |
// |  {  |  }  |  [  |  ]  |     |   |     |  1  |  2  |  3  |  =  |
//             | GUI |     | SPC |   | ENT |  0  | MSE |
            bindings = <
   &kp GRAVE    &kp DQT      &kp LPAR     &kp RPAR     &trans       &kp BSLH   &kp N7     &kp N8  &kp N9  &kp MINUS
   &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &kp LSHIFT   &bt BT_CLR   &caps_word &kp N4     &kp N5  &kp N6  &kp PLUS
   &kp LBRC     &kp RBRC     &kp LBKT     &kp RBKT     &trans       &trans     &kp N1     &kp N2  &kp N3  &kp EQUAL
                             &kp LGUI     &trans       &kp SPACE    &kp RET    &kp N0     &mo 3
            >;
        };

        raise_layer {
// -----------------------------------------------------------------------------------------
// | F1  | F2  | F3  | F4  | F5  |   | F6  | F7  | F8  | F9  | F10 |
// | TAB | ESC |     |     |     |   | LFT | DWN |  UP | RGT | F11 |
// | BR- | BR+ |     |     |     |   |     | MUT | V-  | V+  | F12 |
//             | GUI |     | SPC |   | ENT |     | MSE |
            bindings = <
   &kp F1       &kp F2       &kp F3   &kp F4   &kp F5       &kp F6    &kp F7       &kp F8       &kp F9       &kp F10
   &trans       &trans       &trans   &trans   &trans       &kp LEFT  &kp DOWN     &kp UP       &kp RIGHT    &kp F11
   &kp C_BRI_DN &kp C_BRI_UP &trans   &trans   &trans       &trans    &kp C_MUTE   &kp C_VOL_DN &kp C_VOL_UP &kp F12
                         &kp LGUI &trans   &kp SPACE    &kp RET   &trans    &mo 3
            >;
        };

        mouse_layer {
// -----------------------------------------------------------------------------------------
// |     |     |     |     |     |   |     |     |     |     |     |
// |     |     |     |     |     |   |  ←  |  ↓  |  ↑  |  →  |     |
// |     |     |     |     |     |   |     | LCK | RCK | MCK |     |
//             |     |     |     |   |     |     | MSE |
            bindings = <
   &trans &trans &trans &trans &trans   &trans          &trans          &trans        &trans           &trans
   &trans &trans &trans &trans &trans   &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans
   &trans &trans &trans &trans &trans   &trans          &mkp LCLK       &mkp RCLK     &mkp MCLK        &trans
                 &trans &trans &trans   &trans          &trans          &mo 3
            >;
        };
    };
};
